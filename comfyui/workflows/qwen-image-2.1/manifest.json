      "inputName": "vae_name",
      "required": true
    },
    {
      "id": "qwen21-consistency",
      "kind": "lora",
      "directory": "models/loras",
      "file": "qwen-image-2.1-consistency.safetensors",
      "source": "https://huggingface.co/zimageapp/qwen-image-2.1-loras/resolve/main/qwen-image-2.1-consistency.safetensors",
      "sha256": "4f44ada1be2189cc23b3d010f9603543403f48454e2f76842a3d30109b20bd63",
      "loaderNodeType": "LoraLoaderModelOnly",
      "inputName": "lora_name",
      "required": false,
      "profile": "consistency"
    }
  ],
  "bindings": {
    "prompt": "7.inputs.prompt",
    "seed": "8.inputs.seed",
    "outputPrefix": "10.inputs.filename_prefix"
