{
  "id": "qwen-image-2.1",
  "aliases": [
    "qwen-image-2.1-local",
    "qwen-image-2.1-transparent-local",
    "qwen-image-2.1-consistency-local"
  ],
  "name": "Qwen Image 2.1 本地图片路由",
  "provider": "comfyui",
  "mediaType": "image",
  "templates": {
    "fast": "image_api.json",
    "quality": "image_api.json"
  },
  "defaults": {
    "mode": "quality",
    "aspectRatio": "1:1"
  },
  "capabilities": {
