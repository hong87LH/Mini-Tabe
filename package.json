{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "dev:react": "vite --port=3000 --host=0.0.0.0",
    "dev:electron": "wait-on http://127.0.0.1:3000 && electron .",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dist": "vite build && electron-builder",
    "dev:local": "concurrently -k -s first \"npm run dev:react\" \"npm run dev:electron\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-react": "^5.0.4",
    "ali-oss": "^6.23.0",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "expr-eval": "^2.0.2",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "concurrently": "^9.2.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.example.app",
    "productName": "LingwuApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "network_job_store.js",
      "network_polling.js",
      "lingwu_client.js",
      "lingwu_image_model_profiles.js",
      "video_param_mapper.js",
      "network_utils.js",
      "oss_uploader.js",
      "oss_reference_profiles.js",
      "oss_storage_manager.js",
      "media_job_runner.js",
      "resumable_downloader.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}